# Copy to .env (next to manage.py) and adjust. Every value is optional for local development.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite (db.sqlite3) when unset. Examples:
# DATABASE_URL=mysql://alx_user:alx_password@127.0.0.1:3306/alx_travel_app
# DATABASE_URL=postgres://alx_user:alx_password@127.0.0.1:5432/alx_travel_app

# Chapa payments (test keys start with CHASECK_TEST-)
CHAPA_SECRET_KEY=
# CHAPA_CALLBACK_URL=https://your-domain.example/api/payments/verify/
# CHAPA_RETURN_URL=https://your-frontend.example/payment-complete

# Celery with RabbitMQ. True runs tasks inside the web process (no broker or worker needed);
# set False when RabbitMQ and a worker are running.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Email: printed to the console by default. For real SMTP delivery:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=you@example.com
